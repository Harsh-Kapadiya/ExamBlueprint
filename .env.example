# Copy this file to .env.local for local development. Never commit .env.local.
# On Vercel, set the same variables in Project Settings > Environment Variables.

NEXTAUTH_URL=http://localhost:3000
# Any long random string, e.g. the output of: openssl rand -base64 32
NEXTAUTH_SECRET=

# Client ID and secret of the GitHub App (see README, "Running the project")
GITHUB_ID=
GITHUB_SECRET=

# Only these people can open /admin: comma-separated GitHub profile URLs
ADMIN_GITHUB_PROFILES=https://github.com/Harsh-Kapadiya
